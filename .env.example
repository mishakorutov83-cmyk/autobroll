# Telegram bot token from @BotFather
BOT_TOKEN=
# Telegram user ids allowed to use the bot, comma-separated (the bot tells an unknown user their id)
ALLOWED_USERS=
# Optional — files over 20 MB sent straight to the bot. Without them the bot takes Google Drive links
# (any size) and files up to 20 MB. https://my.telegram.org → API development tools, then start with
#   docker compose --profile bigfiles up -d --build
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# uncomment together with the two lines above
# BOT_API_URL=http://telegram-bot-api:8081
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# optional
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=high
