# Web app (iPhone): the access code you type on the login screen — make it long
WEB_PASSWORD=
# VPS with a domain only (docker compose --profile https): e.g. video.example.com
# DOMAIN=

# Public HTTPS address of the web app — what the bot's «⬆️ Загрузить видео на сервер» button opens inside Telegram.
# Leave empty with the Cloudflare tunnel (docker compose --profile tunnel): the bot reads the tunnel's address itself.
# On a server with a domain: PUBLIC_URL=https://video.example.com
# PUBLIC_URL=

# Telegram bot token from @BotFather (optional — without it only the web app runs)
BOT_TOKEN=
# Telegram user ids allowed to use the bot, comma-separated (the bot tells an unknown user their id)
ALLOWED_USERS=
# Optional — files over 20 MB sent straight to the bot. Without them the bot takes Google Drive links
# (any size) and files up to 20 MB. https://my.telegram.org → API development tools, then start with
#   docker compose --profile bigfiles up -d --build
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# uncomment together with the two lines above
# BOT_API_URL=http://telegram-bot-api:8081
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Cost of Claude: most of the bill is what the model writes (reasoning + plans), so model and effort matter.
# AGENT_PROFILE=balanced   quality  = Opus everywhere, high effort (dearest)
#                          balanced = Opus for the main cut, Sonnet for variants and the meaning check (default)
#                          economy  = Sonnet for the main cut, Haiku for variants and the check (cheapest)
# The app and the bot show «Claude ≈ $…» for every video — compare profiles on the same footage.
# Per step, if you want (model ids: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5; effort: low|medium|high):
# AGENT_MODEL=            AGENT_EFFORT=            main cut
# AGENT_VARIANT_MODEL=    AGENT_VARIANT_EFFORT=    variants
# AGENT_CHECK_MODEL=      AGENT_CHECK_EFFORT=      meaning check

# Speech model download (Hugging Face). If it fails with «429 Too Many Requests» (shared VPN address):
# a free token from https://huggingface.co/settings/tokens (type Read) lifts the limit
# HF_TOKEN=
# if huggingface.co is unreachable, a mirror:
# HF_ENDPOINT=https://hf-mirror.com
