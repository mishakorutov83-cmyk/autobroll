# Telegram bot token from @BotFather
BOT_TOKEN=
# Telegram user ids allowed to use the bot, comma-separated (the bot tells an unknown user their id)
ALLOWED_USERS=
# https://my.telegram.org → API development tools (needed by the self-hosted Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# optional
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=high
