# Video agent + Telegram bot. Build: docker compose build   Run: docker compose up -d
FROM node:22-bookworm
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      ffmpeg python3 python3-pip curl ca-certificates \
      libnss3 libdbus-1-3 libatk1.0-0 libgbm1 libasound2 libxrandr2 libxkbcommon0 libxfixes3 libxcomposite1 libxdamage1 libatk-bridge2.0-0 libcups2 libpango-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --loglevel=error
COPY scripts/reel/requirements.txt scripts/reel/requirements.txt
COPY agent/requirements.txt agent/requirements.txt
RUN pip3 install --break-system-packages -q -r scripts/reel/requirements.txt -r agent/requirements.txt
# models, fonts and Remotion's headless Chrome first — this slow layer is rebuilt only when
# scripts/reel changes, not on every code update
COPY scripts/reel scripts/reel
COPY public/fonts public/fonts
# a checkout made on Windows has CRLF line endings — bash inside Linux can't run those scripts
RUN find scripts -name '*.sh' -exec sed -i 's/\r$//' {} + && bash scripts/reel/setup.sh
COPY . .
ENV PYTHONUNBUFFERED=1
EXPOSE 8080
# web app (iPhone) + Telegram bot (if BOT_TOKEN is set) in one process
CMD ["python3", "-m", "agent.app"]
